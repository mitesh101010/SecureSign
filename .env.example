# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Hedera payer/operator (ED25519 testnet account used to pay fees + bootstrap resources)
HEDERA_OPERATOR_ID=0.0.1234
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...
HEDERA_NETWORK=testnet

# Optional mirror-node override
# testnet default: https://testnet.mirrornode.hedera.com
# mainnet default: https://mainnet-public.mirrornode.hedera.com
HEDERA_MIRROR_NODE_URL=

# Optional: pre-existing wallet account controlled by the KMS secp256k1 public key
HEDERA_ACCOUNT_ID=

# Optional: pre-existing HCS topic for audit logs
HEDERA_HCS_TOPIC_ID=

# Optional wallet bootstrap defaults
HEDERA_INITIAL_BALANCE_HBAR=10
PORT=3001

# Frontend
VITE_API_BASE=http://localhost:3001
